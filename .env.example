# Postgres for the admin, leads and analytics (Neon, Supabase pooler, or local).
# Create tables + seed content once:  DATABASE_URL=... npm run db:setup
DATABASE_URL=

# Admin login (/admin). Make the hash with:  npx tsx scripts/hash-password.ts '<password>'
ADMIN_USER=ob
ADMIN_PASSWORD_HASH=
# 32+ random chars; signs the admin session cookie (openssl rand -hex 32)
ADMIN_SECRET=
# Random salt for cookieless visitor counting (openssl rand -hex 16)
ANALYTICS_SALT=

# Public site URL override (defaults to https://www.obclub.co)
NEXT_PUBLIC_SITE_URL=

# Resend email notifications for new leads (optional: leads are always saved in the admin).
RESEND_API_KEY=
# From address on a Resend-verified domain, e.g. "OB Club <hello@obclub.co>".
RESEND_FROM=
# Inbox that receives contact messages + new-subscriber alerts.
LEADS_TO=hello@obclub.co
