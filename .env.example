# Copy to .env.local for local builds. On GitHub, set these as repository
# variables (Settings → Secrets and variables → Actions → Variables).
# Both are baked into the static site at build time, so they are public.

# Formspree form endpoint for the contact + sign-up forms (https://formspree.io).
# Without it, the forms open the visitor's email app addressed to hello@obclub.co.
NEXT_PUBLIC_FORM_ENDPOINT=

# Public site URL override (defaults to https://obclub.co)
NEXT_PUBLIC_SITE_URL=
